{
  "name": "@neeetman/desktop-agent-bridge",
  "version": "0.8.4",
  "description": "Windows desktop agent messaging, replies, decisions and session control for Codex, Claude and DeepSeek Harness",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/node/*.test.mjs",
    "test:python": "python scripts/dev/test-python.py",
    "status": "node src/supervisor/supervisor-status.mjs",
    "check": "node scripts/dev/check-source.mjs",
    "doctor": "node bin/desktop-agent-bridge.mjs doctor",
    "prepack": "npm run check",
    "prepublishOnly": "npm test && npm run test:python && npm run check",
    "source:refresh": "node scripts/dev/update-source-revisions.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "license": "MIT",
  "author": "neeetman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neeetman/desktop-agent-bridge.git"
  },
  "homepage": "https://github.com/neeetman/desktop-agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/neeetman/desktop-agent-bridge/issues"
  },
  "bin": {
    "desktop-agent-bridge": "bin/desktop-agent-bridge.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/*.ps1",
    "scripts/lib/*.py",
    "scripts/install/*.py",
    "scripts/runtime/*.py",
    "scripts/runtime/*.pyw",
    "scripts/maintenance/*.py",
    "scripts/dev/check-source.mjs",
    "compat/",
    "docs/",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "requirements.txt",
    "CONTRIBUTING.md"
  ]
}
